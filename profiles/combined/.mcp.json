{
  "mcpServers": {
    "cryosparc": {
      "type": "stdio",
      "command": "../../libexec/em-claw-cryosparc-mcp",
      "args": [],
      "env": {
        "EMCLAW_CRYOSPARC_ENV_FILE": "${EMCLAW_CRYOSPARC_ENV_FILE}"
      },
      "timeout": 1200000
    },
    "relion": {
      "type": "stdio",
      "command": "../../libexec/em-claw-relion-mcp",
      "args": [],
      "env": {
        "EMCLAW_RELION_ENV_FILE": "${EMCLAW_RELION_ENV_FILE}",
        "EMCLAW_CRYOSPARC_ENV_FILE": "${EMCLAW_CRYOSPARC_ENV_FILE}",
        "EMCLAW_COMBINED_ROUTE": "1",
        "RELION_MCP_MODE": "${RELION_MCP_MODE:-run}",
        "RELION_PROJECT_ROOTS": "${RELION_PROJECT_ROOTS}",
        "RELION_SCRATCH_DIR": "${RELION_SCRATCH_DIR}"
      },
      "timeout": 1200000
    }
  }
}
