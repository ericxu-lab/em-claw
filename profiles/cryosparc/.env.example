# Copy this file to .env, keep it mode 0600, and replace every placeholder.

# --- Required: CryoSPARC agent directory and connection -------------------------
# Agent directory holding .claude/agents/, .claude/skills/ and projects/ (see INSTALL.md);
# the bundled one is profiles/cryosparc-agent.
EMCLAW_CRYOSPARC_SOURCE=/absolute/path/to/em-claw/profiles/cryosparc-agent
CRYOSPARC_LICENSE_ID=YOUR_CRYOSPARC_LICENSE_ID
CRYOSPARC_MASTER_HOSTNAME=YOUR_CRYOSPARC_MASTER_HOST
CRYOSPARC_BASE_PORT=39000
CRYOSPARC_EMAIL=YOUR_CRYOSPARC_ACCOUNT_EMAIL
CRYOSPARC_PASSWORD=YOUR_CRYOSPARC_ACCOUNT_PASSWORD

# --- Optional: external tools used by the CryoSPARC profile helpers -------------
# Leave a line commented out to keep its YOUR_..._PATH placeholder; the helper that
# needs it then fails with a clear error instead of running a wrong program.

# RELION 5 class_ranker (2d_select/)
#EMCLAW_RELION_CLASS_RANKER=YOUR_RELION5_BIN_PATH/relion_class_ranker
#EMCLAW_RELION_PYTHON=YOUR_RELION5_PYTHON_PATH
#EMCLAW_RELION_TORCH_HOME=YOUR_RELION_TORCH_HOME_PATH
#EMCLAW_RELION_MODULE=YOUR_RELION_MODULE_NAME
#EMCLAW_RELION_MODULEPATH=YOUR_MODULEFILES_PATH
#EMCLAW_RELION_RUNS_DIR=YOUR_WRITABLE_SCRATCH_PATH/relion_runs

# Topaz picking in the bundled pipelines/zll_260130 notebook
#EMCLAW_TOPAZ_EXE=YOUR_TOPAZ_PATH

# CryoRanker particle ranking (cryoemranker/); per-project cryoranker_* keys in
# base_datainfo.yaml take precedence.
#EMCLAW_CRYO_IEF_DIR=YOUR_CRYO_IEF_PATH

# Model-derived masks (build_model_mask/)
#EMCLAW_POWERFIT_EXE=YOUR_POWERFIT_PATH
#EMCLAW_PHENIX_BIN=YOUR_PHENIX_BIN_PATH
#EMCLAW_CHIMERAX=chimerax

# ChimeraX surface rendering (vis_res/); unset renders on the local host
#VIS_RES_RENDER_HOST=YOUR_GPU_RENDER_HOST
#VIS_RES_RENDER_LD_PATH=YOUR_CHIMERAX_LIBRARY_FIX_PATH

# History-bank digests (tools/build_history_digest.py, tools/build_dbdump_digest.py)
#EMCLAW_HISTORY_PDF_ROOT=YOUR_HISTORY_PDF_PATH
#EMCLAW_CRYOSPARC_HOME_ROOT=/home
