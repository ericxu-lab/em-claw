# Copy this file to .env and keep the machine-local result out of version control.
RELION_MCP_MODE=run
RELION_PROJECT_ROOTS=/absolute/path/to/approved/relion-projects
# Configure pyem only when importing CryoSPARC particles for RELION Class3D.
RELION_PYEM_PYTHON=/absolute/path/to/pyem-python
RELION_CSPARC2STAR=/absolute/path/to/csparc2star.py
# Required only when bin/em-claw relion imports CryoSPARC particles.
# RELION_CRYOSPARC_IMPORT_ROOTS=/absolute/path/to/cryosparc-projects
RELION_SCRATCH_DIR=
RELION_PIPELINE_NAME=default

# Native executables. Absolute paths are recommended for cluster launches.
RELION_PIPELINER=relion_pipeliner
RELION_IMAGE_HANDLER=relion_image_handler
RELION_STAR_HANDLER=relion_star_handler
RELION_CLASS_SELECTOR=relion-mcp-class-select
RELION_TOPAZ_EXECUTABLE=topaz

RELION_ADD_JOB_TIMEOUT=90
RELION_UTILITY_TIMEOUT=900
RELION_SYMMETRY_ALIGNMENT_MAX_BOX_PX=512
RELION_VISUAL_MAX_SIDE_PX=2800
RELION_VISUAL_MAX_PNG_BYTES=6000000
RELION_VISUAL_MAX_PANELS=96
